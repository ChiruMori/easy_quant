# 复制为 backend/.env 后修改；不得提交真实密钥、联系方式或第三方凭据。
EASY_QUANT_DATABASE_URL=mysql+pymysql://easy_quant:change-me@127.0.0.1:3306/easy_quant
EASY_QUANT_SECRET_KEY=replace-with-a-long-random-value
EASY_QUANT_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-distinct-encryption-secret
EASY_QUANT_INITIAL_ADMIN_USERNAME=admin
EASY_QUANT_INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
EASY_QUANT_SESSION_COOKIE_SECURE=false
EASY_QUANT_WORKER_POLL_SECONDS=1
EASY_QUANT_STRATEGY_TIMEOUT_SECONDS=30
EASY_QUANT_STRATEGY_OUTPUT_LIMIT_BYTES=65536
EASY_QUANT_INTRADAY_POLL_SECONDS=60
EASY_QUANT_NTFY_BASE_URL=https://ntfy.sh
# 邮件渠道可选；未配置时邮件投递会明确标记失败。
# EASY_QUANT_SMTP_HOST=smtp.example.com
# EASY_QUANT_SMTP_PORT=587
# EASY_QUANT_SMTP_SENDER=easy-quant@example.com
# EASY_QUANT_SMTP_USERNAME=
# EASY_QUANT_SMTP_PASSWORD=
