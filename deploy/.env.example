# 复制为 .env，仅部署端保存。含 $ 的配置用单引号包裹，禁止提交真实凭据。
# GHCR 路径必须小写；IMAGE_TAG 推荐固定为 sha-<完整提交 SHA>。
IMAGE_PREFIX=ghcr.io/chirumori/easy_quant
IMAGE_TAG=master
# localhost 指向容器自身。填写容器可达的外部 MariaDB 主机。
# URL 用户名/密码中的 @、:、/、%、# 等字符必须百分号编码。
DATABASE_URL='mysql+pymysql://easy_quant:change-me@db.example.internal:3306/easy_quant?charset=utf8mb4'
SECRET_KEY=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-distinct-encryption-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
# HTTPS 入口设为 true；直接 HTTP 调试时为 false。
SESSION_COOKIE_SECURE=false
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
WORKER_POLL_SECONDS=1
STRATEGY_TIMEOUT_SECONDS=30
STRATEGY_OUTPUT_LIMIT_BYTES=65536
INTRADAY_RUN_TIME=14:50
DAILY_DATA_PUBLISH_TIME=22:00
# 通知为外部依赖，不会启动 ntfy 或 SMTP 容器。
NTFY_BASE_URL=https://ntfy.sh
SMTP_HOST=
SMTP_PORT=25
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=
